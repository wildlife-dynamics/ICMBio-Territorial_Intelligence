{
  "properties": {
    "workflow_details": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Workflow Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Workflow Description",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object",
      "description": "Add information that will help to differentiate this workflow from another.",
      "title": "Workflow Details"
    },
    "er_client": {
      "additionalProperties": false,
      "properties": {
        "data_source": {
          "$ref": "#/$defs/EarthRangerConnection",
          "title": "",
          "description": "Select one of your configured data sources."
        }
      },
      "required": [
        "data_source"
      ],
      "type": "object",
      "title": "Data Source"
    },
    "time_range": {
      "additionalProperties": false,
      "properties": {
        "since": {
          "format": "date-time",
          "title": "Since",
          "type": "string",
          "description": "The start time"
        },
        "until": {
          "format": "date-time",
          "title": "Until",
          "type": "string",
          "description": "The end time"
        },
        "timezone": {
          "allOf": [
            {
              "$ref": "#/$defs/TimezoneInfo"
            }
          ],
          "default": null,
          "title": "Timezone"
        }
      },
      "required": [
        "since",
        "until"
      ],
      "type": "object",
      "description": "Choose the period of time to analyze.",
      "title": "Time Range"
    },
    "base_maps": {
      "additionalProperties": false,
      "properties": {
        "base_maps": {
          "default": [
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
              "opacity": 1,
              "max_zoom": 20,
              "min_zoom": 0
            },
            {
              "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
              "opacity": 0.5,
              "max_zoom": 20,
              "min_zoom": 0
            }
          ],
          "items": {
            "title": "Base Layer",
            "anyOf": [
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
                    "enum": [
                      "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Open Street Map",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Roadmap",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Satellite",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "Terrain",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "title": "Preset Layer URL",
                    "type": "string",
                    "const": "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}",
                    "enum": [
                      "https://server.arcgisonline.com/arcgis/rest/services/Elevation/World_Hillshade/MapServer/tile/{z}/{y}/{x}"
                    ]
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Layer Opacity",
                    "type": "number"
                  }
                },
                "title": "USGS Hillshade",
                "type": "object"
              },
              {
                "description": "A tiled raster layer loaded on-demand from a URL template (e.g., base maps).",
                "properties": {
                  "url": {
                    "default": "https://example.tiles.com/{z}/{x}/{y}.png",
                    "description": "The URL of a publicly accessible tiled raster service.",
                    "pattern": "https?:\\/\\/(www\\.)?[-a-zA-Z0-9@:%._\\+~#=]{1,256}\\.[a-zA-Z0-9()]{1,6}([-a-zA-Z0-9()@:%_\\+.~#?&//=\\{\\}]*)",
                    "title": "Custom Layer URL",
                    "type": "string"
                  },
                  "opacity": {
                    "default": 1,
                    "description": "Set layer transparency from 1 (fully visible) to 0 (hidden).",
                    "ecoscope:advanced": true,
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "title": "Custom Layer Opacity",
                    "type": "number"
                  },
                  "max_zoom": {
                    "default": 20,
                    "description": "Set the maximum zoom level to fetch tiles for.",
                    "title": "Custom Layer Max Zoom",
                    "type": "integer"
                  },
                  "min_zoom": {
                    "default": 0,
                    "description": "Set the minimum zoom level to fetch tiles for.",
                    "title": "Custom Layer Min Zoom",
                    "type": "integer"
                  }
                },
                "title": "Custom Layer (Advanced)",
                "type": "object"
              }
            ]
          },
          "title": " ",
          "type": "array",
          "description": "Select tile layers to use as base layers in map outputs. The first layer in the list will be the bottommost layer displayed.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Base Maps"
    },
    "viewport_settings": {
      "additionalProperties": false,
      "properties": {
        "settings": {
          "allOf": [
            {
              "$ref": "#/$defs/ViewportSettings"
            }
          ],
          "default": {
            "width_px": 650,
            "height_px": 450,
            "padding_fraction": 0.03,
            "outlier_trim_percent": 1.0
          },
          "title": ""
        }
      },
      "type": "object",
      "required": [],
      "title": ""
    },
    "events_raw": {
      "additionalProperties": false,
      "properties": {
        "event_states": {
          "default": null,
          "items": {
            "type": "string",
            "oneOf": [
              {
                "const": "new",
                "title": "New"
              },
              {
                "const": "active",
                "title": "Active"
              },
              {
                "const": "resolved",
                "title": "Resolved"
              },
              {
                "const": "review",
                "title": "Review"
              }
            ]
          },
          "title": "Event State",
          "type": "array",
          "description": "Choose to analyze events with a certain state. If left empty, events of all states will be analyzed",
          "uniqueItems": true,
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    },
    "event_colormap": {
      "additionalProperties": false,
      "properties": {
        "custom_colors": {
          "items": {
            "type": "string"
          },
          "title": "Custom Colors",
          "type": "array",
          "description": "Hex color list, e.g. ['#e41a1c', '#377eb8']. Cycles if more categories than colors."
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    },
    "event_layer": {
      "additionalProperties": false,
      "properties": {
        "tooltip_columns": {
          "default": null,
          "items": {
            "type": "string"
          },
          "title": "Tooltip Columns",
          "type": "array",
          "description": "Restrict the on-hover tooltip to these column names. None (default) shows all properties.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": ""
    },
    "hotspots_clustered": {
      "additionalProperties": false,
      "properties": {
        "radius_km": {
          "default": 4.0,
          "exclusiveMinimum": 0.0,
          "title": "Radius Km",
          "type": "number",
          "description": "Approximate radius (km) used to group nearby events into a hotspot \u2014 matches the PRD's own stated methodology."
        },
        "min_events": {
          "default": 3,
          "minimum": 1,
          "title": "Min Events",
          "type": "integer",
          "description": "Minimum events required for a group of nearby points to count as a hotspot."
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    },
    "patrol_observations": {
      "additionalProperties": false,
      "properties": {
        "patrols_overlap_daterange": {
          "default": true,
          "title": "Patrols Overlap Daterange",
          "type": "boolean",
          "description": "Whether or not to include patrols that start or end outside of the time range",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    },
    "relocs_in_bounds": {
      "additionalProperties": false,
      "properties": {
        "bounding_box": {
          "allOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            }
          ],
          "default": {
            "min_y": -90.0,
            "max_y": 90.0,
            "min_x": -180.0,
            "max_x": 180.0
          },
          "title": "Bounding Box",
          "description": "Filter events to inside these bounding coordinates.",
          "ecoscope:advanced": true
        },
        "filter_point_coords": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Coordinate"
          },
          "title": "Filter Exact Point Coordinates",
          "type": "array",
          "description": "By adding a filter, the workflow will not include events recorded at the specified coordinates.",
          "ecoscope:advanced": true
        }
      },
      "required": [],
      "type": "object",
      "title": ""
    },
    "download_attachments": {
      "additionalProperties": false,
      "properties": {
        "attachments_subdir": {
          "default": "attachments",
          "title": "Attachments Subdirectory",
          "type": "string",
          "description": "Subdirectory inside the output directory to store attachments.",
          "ecoscope:advanced": true
        },
        "skip_download": {
          "default": false,
          "title": "Skip Download",
          "type": "boolean",
          "description": "If True, skip downloading attachments."
        }
      },
      "required": [],
      "type": "object",
      "title": "Download Event Attachments"
    },
    "report_template_path": {
      "additionalProperties": false,
      "properties": {
        "var": {
          "title": "",
          "type": "string"
        }
      },
      "required": [
        "var"
      ],
      "type": "object",
      "title": ""
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "ViewportSettings": {
      "properties": {
        "width_px": {
          "default": 650,
          "description": "Actual rendered map width in pixels \u2014 a dashboard tile, not the full browser window. Our map widgets use half the 10-column dashboard grid (layout.json), which measures ~450-870px wide in practice; 650 is the middle of that range.",
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0,
          "title": "Map Width (px)",
          "type": "integer"
        },
        "height_px": {
          "default": 450,
          "description": "Actual rendered map height in pixels.",
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0,
          "title": "Map Height (px)",
          "type": "integer"
        },
        "padding_fraction": {
          "default": 0.03,
          "description": "Fraction of the viewport left as empty margin around the data on each side.",
          "ecoscope:advanced": true,
          "maximum": 0.4,
          "minimum": 0.0,
          "title": "Padding Around Data",
          "type": "number"
        },
        "outlier_trim_percent": {
          "default": 1.0,
          "description": "Percentile trimmed from each end of the coordinate range before framing (e.g. 1 uses the 1st-99th percentile). Makes framing robust to a small number of extreme outliers, such as a bad GPS fix, without needing to filter them out of the data itself. Keep this low, since a real patrol trajectory's own extremities can span a wide percentile range, so a high value crops legitimate track data out of the frame.",
          "ecoscope:advanced": true,
          "maximum": 45.0,
          "minimum": 0.0,
          "title": "Outlier Trim (%)",
          "type": "number"
        }
      },
      "title": "ViewportSettings",
      "type": "object"
    },
    "BoundingBox": {
      "properties": {
        "min_y": {
          "default": -90.0,
          "ecoscope:advanced": true,
          "title": "Min Latitude",
          "type": "number"
        },
        "max_y": {
          "default": 90.0,
          "ecoscope:advanced": true,
          "title": "Max Latitude",
          "type": "number"
        },
        "min_x": {
          "default": -180.0,
          "ecoscope:advanced": true,
          "title": "Min Longitude",
          "type": "number"
        },
        "max_x": {
          "default": 180.0,
          "ecoscope:advanced": true,
          "title": "Max Longitude",
          "type": "number"
        }
      },
      "title": "BoundingBox",
      "type": "object"
    },
    "Coordinate": {
      "properties": {
        "y": {
          "description": "Example -0.15293",
          "title": "Latitude",
          "type": "number"
        },
        "x": {
          "description": "Example 37.30906",
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "y",
        "x"
      ],
      "title": "Coordinate",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "hotspots_clustered": {
      "ui:order": [
        "radius_km",
        "min_events"
      ]
    },
    "relocs_in_bounds": {
      "ui:order": [
        "bounding_box",
        "filter_point_coords"
      ]
    },
    "download_attachments": {
      "ui:order": [
        "attachments_subdir",
        "skip_download"
      ]
    },
    "ui:order": [
      "workflow_details",
      "er_client",
      "time_range",
      "base_maps",
      "viewport_settings",
      "events_raw",
      "event_colormap",
      "event_layer",
      "hotspots_clustered",
      "patrol_observations",
      "relocs_in_bounds",
      "download_attachments",
      "report_template_path"
    ]
  },
  "additionalProperties": false
}
