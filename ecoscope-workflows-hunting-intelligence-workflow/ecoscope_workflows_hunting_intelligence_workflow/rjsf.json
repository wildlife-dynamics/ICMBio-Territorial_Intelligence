          },
          "title": " ",
          "type": "array",
          "description": "Select tile layers to use as base layers in map outputs. The first layer in the list will be the bottommost layer displayed.",
          "ecoscope:advanced": true
        }
      },
      "type": "object",
      "required": [],
      "title": "Base Maps"
    },
    "Map Viewport": {
      "type": "object",
      "description": "Controls how tightly the events map zooms and frames its data.",
      "ecoscope:task_group": true,
      "properties": {
        "viewport_settings": {
          "additionalProperties": false,
          "properties": {
            "settings": {
              "allOf": [
                {
                  "$ref": "#/$defs/ViewportSettings"
                }
              ],
              "default": {
                "width_px": 650,
                "height_px": 450,
                "padding_fraction": 0.03,
                "outlier_trim_percent": 1.0
              },
              "title": "Map Viewport",
              "description": "Controls how tightly the events map zooms and frames its data. Only adjust if the map consistently looks too zoomed in or out.",
              "ecoscope:advanced": true
            }
          },
          "type": "object",
          "required": [],
          "title": ""
        }
      }
    },
    "Distribui\u00e7\u00e3o Territorial e Hotspots": {
      "type": "object",
      "description": "General events map, spatial density, and exploratory hotspot clustering.",
      "ecoscope:task_group": true,
      "properties": {
        "event_colormap": {
          "additionalProperties": false,
          "properties": {
            "custom_colors": {
              "items": {
                "type": "string"
              },
              "title": "Custom Colors",
              "type": "array",
              "description": "Hex color list, e.g. ['#e41a1c', '#377eb8']. Cycles if more categories than colors."
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        },
        "event_layer": {
          "additionalProperties": false,
          "properties": {
            "tooltip_columns": {
              "default": null,
              "items": {
                "type": "string"
              },
              "title": "Tooltip Columns",
              "type": "array",
              "description": "Restrict the on-hover tooltip to these column names. None (default) shows all properties.",
              "ecoscope:advanced": true
            }
          },
          "type": "object",
          "required": [],
          "title": ""
        },
        "hotspots_clustered": {
          "additionalProperties": false,
          "properties": {
            "radius_km": {
              "default": 4.0,
              "exclusiveMinimum": 0.0,
              "title": "Cluster Radius (km)",
              "type": "number",
              "description": "Approximate radius used to group nearby events into a hotspot \u2014 matches the report's own stated exploratory methodology.",
              "ecoscope:advanced": false
            },
            "min_events": {
              "default": 3,
              "minimum": 1,
              "title": "Minimum Events per Hotspot",
              "type": "integer",
              "description": "Minimum number of nearby events required to count as a hotspot.",
              "ecoscope:advanced": false
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    },
    "Patrol Effort": {
      "type": "object",
      "description": "Km patrulhados, horas trabalhadas, and TDEA (Taxa de Detec\u00e7\u00e3o de Estruturas Ativas) \u2014 patrol-effort context for comparing hunting pressure across periods.",
      "ecoscope:task_group": true,
      "properties": {
        "patrol_observations": {
          "additionalProperties": false,
          "properties": {
            "patrols_overlap_daterange": {
              "default": true,
              "title": "Patrols Overlap Daterange",
              "type": "boolean",
              "description": "Whether or not to include patrols that start or end outside of the time range",
              "ecoscope:advanced": true
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        },
        "relocs_in_bounds": {
          "additionalProperties": false,
          "properties": {
            "filter_point_coords": {
              "default": [],
              "items": {
                "$ref": "#/$defs/Coordinate"
              },
              "title": "Filter Exact Point Coordinates",
              "type": "array",
              "description": "By adding a filter, the workflow will not include events recorded at the specified coordinates.",
              "ecoscope:advanced": true
            }
          },
          "required": [],
          "type": "object",
          "title": ""
        }
      }
    },
    "download_attachments": {
      "additionalProperties": false,
      "properties": {
        "attachments_subdir": {
          "default": "attachments",
          "title": "Attachments Subdirectory",
          "type": "string",
          "description": "Subdirectory inside the output directory to store attachments.",
          "ecoscope:advanced": true
        },
        "skip_download": {
          "default": false,
          "title": "Skip Photo Attachments",
          "type": "boolean",
          "description": "If True, skip downloading event photos, and the report will not include any images in the Evid\u00eancias Fotogr\u00e1ficas section.",
          "ecoscope:advanced": false
        }
      },
      "required": [],
      "type": "object",
      "title": "Download Event Attachments"
    },
    "Report": {
      "type": "object",
      "description": "",
      "ecoscope:task_group": true,
      "properties": {
        "report_template_path": {
          "additionalProperties": false,
          "properties": {
            "var": {
              "title": "Template Path",
              "type": "string",
              "description": "Path or URL to the .docx Jinja2 template used for the hunting intelligence report.",
              "default": "https://raw.githubusercontent.com/wildlife-dynamics/ICMBio-Territorial_Intelligence/main/resources/templates/relatorio_inteligencia_territorial_caca_template.docx",
              "ecoscope:advanced": false
            }
          },
          "required": [
            "var"
          ],
          "type": "object",
          "title": ""
        }
      }
    }
  },
  "$defs": {
    "EarthRangerConnection": {
      "properties": {
        "name": {
          "title": "Data Source",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "EarthRangerConnection",
      "type": "object"
    },
    "TimezoneInfo": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "tzCode": {
          "title": "Tzcode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "utc": {
          "title": "Utc",
          "type": "string"
        }
      },
      "required": [
        "label",
        "tzCode",
        "name",
        "utc"
      ],
      "title": "TimezoneInfo",
      "type": "object"
    },
    "ViewportSettings": {
      "properties": {
        "width_px": {
          "default": 650,
          "description": "Actual rendered map width in pixels \u2014 a dashboard tile, not the full browser window. Our map widgets use half the 10-column dashboard grid (layout.json), which measures ~450-870px wide in practice; 650 is the middle of that range.",
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0,
          "title": "Map Width (px)",
          "type": "integer"
        },
        "height_px": {
          "default": 450,
          "description": "Actual rendered map height in pixels.",
          "ecoscope:advanced": true,
          "exclusiveMinimum": 0,
          "title": "Map Height (px)",
          "type": "integer"
        },
        "padding_fraction": {
          "default": 0.03,
          "description": "Fraction of the viewport left as empty margin around the data on each side.",
          "ecoscope:advanced": true,
          "maximum": 0.4,
          "minimum": 0.0,
          "title": "Padding Around Data",
          "type": "number"
        },
        "outlier_trim_percent": {
          "default": 1.0,
          "description": "Percentile trimmed from each end of the coordinate range before framing (e.g. 1 uses the 1st-99th percentile). Makes framing robust to a small number of extreme outliers, such as a bad GPS fix, without needing to filter them out of the data itself. Keep this low, since a real patrol trajectory's own extremities can span a wide percentile range, so a high value crops legitimate track data out of the frame.",
          "ecoscope:advanced": true,
          "maximum": 45.0,
          "minimum": 0.0,
          "title": "Outlier Trim (%)",
          "type": "number"
        }
      },
      "title": "ViewportSettings",
      "type": "object"
    },
    "Coordinate": {
      "properties": {
        "y": {
          "description": "Example -0.15293",
          "title": "Latitude",
          "type": "number"
        },
        "x": {
          "description": "Example 37.30906",
          "title": "Longitude",
          "type": "number"
        }
      },
      "required": [
        "y",
        "x"
      ],
      "title": "Coordinate",
      "type": "object"
    }
  },
  "uiSchema": {
    "workflow_details": {
      "ui:order": [
        "name",
        "description"
      ]
    },
    "time_range": {
      "ui:order": [
        "since",
        "until",
        "timezone"
      ]
    },
    "Distribui\u00e7\u00e3o Territorial e Hotspots": {
      "ui:order": [
        "event_colormap",
        "event_layer",
        "hotspots_clustered"
      ],
      "hotspots_clustered": {
        "ui:order": [
          "radius_km",
          "min_events"
        ]
      }
    },
    "Patrol Effort": {
      "ui:order": [
        "patrol_observations",
        "relocs_in_bounds"
      ]
    },
    "download_attachments": {
      "ui:order": [
        "attachments_subdir",
        "skip_download"
      ]
    },
    "ui:order": [
      "workflow_details",
      "er_client",
      "time_range",
      "base_maps",
      "Map Viewport",
      "Distribui\u00e7\u00e3o Territorial e Hotspots",
      "Patrol Effort",
      "download_attachments",
      "Report"
    ]
  },
  "additionalProperties": false
}
